# Raw health data never leaves your machine
data/raw/*
!data/raw/.gitkeep
!data/raw/clarity/
data/raw/clarity/*
!data/raw/clarity/.gitkeep
data/sample/
*.duckdb
*.duckdb.wal

# dbt
transform/target/
transform/logs/
transform/dbt_packages/
transform/.user.yml

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Rendered dashboard contains personal health data
dashboard/*.html
dashboard/*_files/
dashboard/.quarto/
.quarto/

# Development runs on synthetic data are not part of the record
analyses/*/korningar/*_synthetic.json
# Daily status reports are working notes
studies/*/rapporter/
.env
.env.*
*.env.save
data/

# Privata arbetsdokument (läroplaner, utkast) — aldrig publika
docs/privat/

# lokal MCP-config (relativ, men maskin-lokal)
.mcp.json
